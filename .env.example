# Copy to .env, then fill in both values for live research.
# Offline demonstration works with these values left blank.
OPENAI_API_KEY=
TAVILY_API_KEY=
# Shared model for safety screening, the orchestrator and all live specialists.
OPENAI_MODEL=gpt-4o-mini

# Optional availability fallback: OpenAI first, then one Nebius attempt.
# Use the exact model API ID from Nebius, not its display name.
MODEL_ROUTING_ENABLED=false
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Langfuse Cloud project credentials
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Match your Langfuse project region: EU shown below; US uses https://us.cloud.langfuse.com.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Live tracing is optional; failures never block analysis. Demo runs always stay local.
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=development
# Optional directory for rotating operational logs and offline demonstration JSONL files.
# MARKET_LOG_DIR=C:/path/to/private/logs
